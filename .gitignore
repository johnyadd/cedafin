# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Downloaded source documents — reproducible via fetch_factsheets.py
data/factsheets/

# Extractor output — regenerated by extract_navs.py
navs.csv
products.csv
disc10.csv
discovery.csv
discovery-all.csv
discovery-funds.csv

# Throwaway diagnostic scripts
dump*.py
check_text.py

# Python
__pycache__/
*.pyc
engine/.venv/
